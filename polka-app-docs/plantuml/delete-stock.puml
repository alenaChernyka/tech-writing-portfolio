@startuml
title Удаление запаса

actor Пользователь as user
participant Приложение as client
database "Хранилище на устройстве" as storage

user -> client: Нажимает на запас в списке
user <-- client: Открывает форму запаса с текущими данными
user -> client: Нажимает кнопку удаления
user <-- client: Показывает предупреждение о безвозвратном удалении
user -> client: Нажимает «Да»
client -> storage: Удаляет запас
user <-- client: Закрывает форму, показывает список запасов без удаленного запаса

alt Альтернативный сценарий 1: отказ от удаления
user -> client: Нажимает на запас в списке
user <-- client: Открывает форму запаса с текущими данными
user -> client: Нажимает кнопку удаления
user <-- client: Показывает предупреждение о безвозвратном удалении
user -> client: Нажимает «Нет»
user <-- client: Закрывает предупреждение, возвращает в форму запаса
end alt

alt Альтернативный сценарий 2: закрытие формы без удаления
user -> client: Нажимает на запас в списке
user <-- client: Открывает форму запаса с текущими данными
user -> client: Нажимает кнопку закрытия формы (✕)
user <-- client: Закрывает форму, показывает список запасов
end alt
@enduml
