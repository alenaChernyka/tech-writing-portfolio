@startuml

title Просмотр и фильтрация всех запасов

actor Пользователь as user

participant Приложение as client

database "Хранилище на устройстве" as storage

user -> client: Выбирает фильтр по состоянию,\nпо категории или оба фильтра

client -> storage: Запрашивает запасы по выбранным фильтрам

alt Запасы найдены
    storage --> client: Возвращает найденные запасы
    client --> user: Показывает запасы
else Запасов нет
    storage --> client: Возвращает пустой результат
    client --> user: Показывает сообщение,\nчто запасов нет
end

opt Сброс фильтра
    user -> client: Сбрасывает фильтр
    client -> storage: Запрашивает все запасы
    storage --> client: Возвращает все запасы
    client --> user: Показывает все запасы
end

@enduml